# Copy to mcp-agent.secrets.yaml (gitignored) or rely on environment variables:
#   export ANTHROPIC_API_KEY=...
#   export OPENAI_API_KEY=...
#
# Prefer Anthropic for this suite (matches MCPJam Claude runs). OpenAI works if
# only OPENAI_API_KEY is set — tests/conftest.py switches provider automatically.

anthropic:
  api_key: "sk-ant-..."

openai:
  api_key: "sk-..."
