# Copy to .env for local development.
# The MCP server itself needs no API keys (public SSA stats + local SQLite).

MCP_TRANSPORT=stdio            # or streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
# SSA_ALJ_DB_PATH=data/ssa_alj.sqlite

# Optional: eval/sdk mcpevals agent suite (not required to run the server)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
